{
  "POST /api/register": {
    "description": "Registers a new user",
    "request": {
      "body": {
        "username": "string",
        "password": "string"
      }
    },
    "response": {
      "status": 201,
      "body": {
        "message": "User registered",
        "user": {
          "id": "number",
          "username": "string"
        }
      }
    }
  }
}

{
  "POST /api/upload-post": {
    "description": "Creates a new post. Caption is mandatory, image is optional. If an image is uploaded, it will be stored in Supabase Storage. Requires an API key.",
    "middleware": ["verifyAPIKey", "multer (single file upload)"],
    "request": {
      "headers": {
        "Content-Type": "multipart/form-data",
        "x-api-key": "string (required)"
      },
      "body": {
        "id": "string (User ID, required)",
        "caption": "string (required, cannot be empty)",
        "file": "file (optional, image to upload)"
      }
    },
    "response": {
      "status": 200,
      "body": {
        "message": "Post uploaded successfully.",
        "photoIncluded": "boolean (true if file uploaded, false otherwise)",
        "caption": "string",
        "filePath": "string | null (path in Supabase Storage)",
        "publicUrl": "string | null (public URL of image if uploaded)"
      }
    },
    "errors": {
      "400": {
        "error": "Caption is required."
      },
      "400_user": {
        "error": "User ID is required."
      },
      "500_upload": {
        "error": "Failed to upload file."
      },
      "500_insert": {
        "error": "Failed to save post record."
      },
      "500_server": {
        "error": "Internal server error."
      }
    }
  }
}


  "PUT /api/edit-post/:postID": {
    "description": "Edits the caption of an existing post. Only the owner of the post can edit it.",
    "middleware": ["verifyAPIKey"],
    "request": {
      "headers": {
        "Content-Type": "application/json",
        "x-api-key": "string (required)"
      },
      "params": {
        "postID": "string (required)"
      },
      "body": {
        "id": "string (User ID, required)",
        "updatedPostCaption": "string (new caption, required)"
      }
    },
    "response": {
      "status": 200,
      "body": {
        "message": "Post updated successfully.",
        "updatedPost": "object (updated post data)"
      },
      "error": {
        "400": {
          "message": "You can edit only your posts."
        },
        "500": {
          "message": "Internal server error."
        }
      }
    }
  }
}

{
  "POST /api/add-comment/:postId": {
    "description": "Adds a comment to a specific post. Requires API key authentication.",
    "middleware": ["verifyAPIKey"],
    "request": {
      "headers": {
        "Content-Type": "application/json",
        "x-api-key": "string (required)"
      },
      "params": {
        "postId": "string (required)"
      },
      "body": {
        "id": "string (User ID, required)",
        "commentText": "string (Comment content, required)"
      }
    },
    "response": {
      "status": 200,
      "body": {
        "message": "Comment added"
      },
      "error": {
        "400": {
          "message": "Post ID or comment text is required."
        },
        "500": {
          "message": "Error while posting comment or internal server error."
        }
      }
    }
  },

  "DELETE /api/delete-comment/:commentID": {
    "description": "Deletes a comment by its ID. Requires API key authentication.",
    "middleware": ["verifyAPIKey"],
    "request": {
      "headers": {
        "Content-Type": "application/json",
        "x-api-key": "string (required)"
      },
      "params": {
        "commentID": "string (required)"
      }
    },
    "response": {
      "status": 200,
      "body": {
        "message": "Comment deleted successfully."
      },
      "error": {
        "400": {
          "message": "Comment ID is required to delete comment."
        },
        "500": {
          "error": "Failed to delete comment or internal server error."
        }
      }
    }
  },

  "PUT /api/edit-comment/:commentID": {
    "description": "Edits an existing comment. Only the owner of the comment can edit it.",
    "middleware": ["verifyAPIKey"],
    "request": {
      "headers": {
        "Content-Type": "application/json",
        "x-api-key": "string (required)"
      },
      "params": {
        "commentID": "string (required)"
      },
      "body": {
        "id": "string (User ID, required)",
        "updatedCommentText": "string (New comment text, required)"
      }
    },
    "response": {
      "status": 200,
      "body": {
        "message": "Comment updated successfully.",
        "updated": "object (updated comment details)"
      },
      "error": {
        "400": {
          "message": "Comment ID is required."
        },
        "404": {
          "message": "Comment not found or not yours."
        },
        "500": {
          "message": "Error while editing comment or internal server error."
        }
      }
    }
  }
}

{
  "PATCH /api/update-user/:userID": {
    "description": "Updates user details or uploads a new profile picture. If a new profile picture is uploaded, the previous one is removed from Supabase Storage.",
    "auth": {
      "type": "API Key",
      "header": "x-api-key",
      "required": true
    },
    "params": {
      "userID": "string (required)"
    },
    "request": {
      "contentType": "multipart/form-data",
      "body": {
        "file": "binary (optional, new profile picture)",
        "username": "string (optional)",
        "name": "string (optional)",
        "bio": "string (optional)",
        "settings": {
          "theme": "string (optional)",
          "notifications": "boolean (optional)"
        }
      }
    },
    "response": {
      "status": 200,
      "body": {
        "message": "Profile picture updated successfully!",
        "user": {
          "userId": "string",
          "username": "string",
          "name": "string",
          "bio": "string",
          "profilePic": "string (public URL from Supabase)",
          "pfpPath": "string (internal storage path)",
          "settings": {
            "theme": "string",
            "notifications": "boolean"
          }
        }
      }
    },
    "errors": {
      "400": { "error": "No fields provided to update." },
      "404": { "error": "User not found." },
      "500": { "error": "User update failed." }
    }
  }
}

